<Project>
  <ItemGroup>
    <!-- Applies to AomMcp and the lib/CryBarEditor submodule. CryBar pins SixLabors.ImageSharp 3.1.12 (no patched 3.x).
         AomMcp only decodes XMB from installed game archives and never calls CryBar image conversion,
         so these image-decoding advisories are unreachable. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'CryBar'">
    <!-- Release CI publishes with -p:GenerateDocumentationFile=true -warnaserror; upstream CryBar lacks XML docs. -->
    <NoWarn>$(NoWarn);CS1573;CS1574;CS1587;CS1591</NoWarn>
  </PropertyGroup>
</Project>
